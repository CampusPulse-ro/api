<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Production runs on a Raspberry Pi 5, where RAM is the binding constraint.
         Measured on amicus-api, same host: Workstation GC gave the same throughput as
         Server GC for ~47 MB less peak memory (Server GC allocates one heap per core). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Build-time OpenAPI document (Microsoft.Extensions.ApiDescription.Server): openapi/v1.json at
       the repo root. Only on portable builds: a build for one runtime (the multi-arch container,
       the linux-arm64 migrations bundle) can't run the app on the build machine to produce it. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(RuntimeIdentifier)' != ''">false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <!-- Container image without a Dockerfile: `dotnet publish -t:PublishContainer` (built into
       the SDK; no Docker daemon needed to build it). Only for hosts that run images (Cloud Run,
       Azure Container Apps, Fly.io). The Pi runs the plain published output under systemd.
       Base image, non-root `app` user and port 8080 are the SDK defaults for ASP.NET Core. -->
  <PropertyGroup>
    <ContainerRepository>campuspulse-api</ContainerRepository>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    <!-- Restore must include both targets, or the multi-arch publish fails NETSDK1047. This only
         affects restore: a build or publish without -r stays portable. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The timetable import (CampusPulse-ro/api#5): reads the faculty's .xlsx files. MIT. It pulls in
         SixLabors.Fonts 1.x (Apache-2.0); 2.x is under the Six Labors Split License, so check the licence
         before a ClosedXML update raises that dependency. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- The import's overrides file. MIT. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Writes the OpenAPI document at build time: openapi/v1.json at the repo root is the
         contract the mobile and web clients generate their types from, committed, and CI fails
         when it is stale. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned: Microsoft.AspNetCore.OpenApi pulls in Microsoft.OpenApi 2.0.0, which carries
         GHSA-v5pm-xwqc-g5wc (high: circular schema refs abort parsing). 2.7.5 is the first
         patched 2.x release. Do NOT jump to 3.x: it makes IOpenApiMediaType.Example read-only
         and the ASP.NET Core 10 XML-comment source generator fails to compile. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampusPulse.Domain\CampusPulse.Domain.csproj" />
    <ProjectReference Include="..\CampusPulse.Infrastructure\CampusPulse.Infrastructure.csproj" />
  </ItemGroup>

</Project>
