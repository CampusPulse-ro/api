  "components": {
    "schemas": {
      "ActivityKind": {
        "enum": [
          "course",
          "lab",
          "seminar",
          "project",
          "facultative"
        ]
      },
      "ChoiceSubjectResponse": {
        "required": [
          "id",
          "name",
          "shortName",
          "choice",
          "offers"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": [
              "null",
              "string"
            ]
          },
          "choice": {
            "$ref": "#/components/schemas/SubjectChoice"
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferedSlotResponse"
            }
          }
        }
      },
      "DayOfWeek": {
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      },
      "DeviceResponse": {
        "required": [
          "id",
          "platform",
          "createdAt",
          "lastRegisteredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "$ref": "#/components/schemas/PushPlatform"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastRegisteredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "NonTeachingDayResponse": {
        "required": [
          "date",
          "reason"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "OccurrenceResponse": {
        "required": [
          "date",
          "week",
          "startsAt",
          "endsAt",
          "subjectId",
          "subject",
          "shortName",
          "kinds",
          "room",
          "teacher",
          "note",
          "optional",
          "slotId",
          "offeredSlotId"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "week": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "time"
          },
          "endsAt": {
            "type": "string",
            "format": "time"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": "string"
          },
          "shortName": {
            "type": [
              "null",
              "string"
            ]
          },
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityKind"
            }
          },
          "room": {
            "type": [
              "null",
              "string"
            ]
          },
          "teacher": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "slotId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "offeredSlotId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "OfferedSlotResponse": {
        "required": [
          "id",
          "kinds",
          "weekday",
          "startsAt",
          "endsAt",
          "room",
          "weeks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityKind"
            }
          },
          "weekday": {
            "$ref": "#/components/schemas/DayOfWeek"
          },
          "startsAt": {
            "type": "string",
            "format": "time"
          },
          "endsAt": {
            "type": "string",
            "format": "time"
          },
