#!/usr/bin/env bash
# CampusPulse API deploy on the Raspberry Pi.
#
#   campuspulse-deploy stage <ci-run-id> <sha> [--force]         a green CI run of a push to main
#   campuspulse-deploy prod  <release-run-id> <vX.Y.Z> [--force] a green Release run
#   campuspulse-deploy rollback stage|prod                       back to the previous healthy release
#
# --force deploys even when the build is not the newest one (an older main commit, an older release).
#
# Started by pi-control's /gh/campuspulse-deploy webhook (a signed GitHub workflow_run event; no
# self-hosted runner, the repo is public), or by hand. Whoever starts it, the run is re-checked with
# GitHub: only a successful run of OUR workflow file, for the right event and ref, is deployed, and
# a prod release's files must carry a build attestation from release.yml at that tag.
#
# Runs as the Pi's admin user (gh is signed in there) and uses sudo to install. Installed BY HAND
# (`sudo install -m 755 deploy/pi/campuspulse-deploy /usr/local/bin/`), never by a webhook, so a bad
# build can't change how deploys run.
#
# Each environment has its own user (campuspulse-stage / campuspulse-prod). Releases are root-owned
# and read-only to the app; env files are root-only and read by systemd, never by this script, so the
# database password never appears in a command line. Migrations run as a sandboxed one-off unit.
set -Eeuo pipefail   # -E: the ERR trap also fires inside functions

REPO=CampusPulse-ro/api
CI_WORKFLOW=.github/workflows/ci.yml
RELEASE_WORKFLOW=.github/workflows/release.yml
ROOT=/srv/campuspulse
KEEP=5                                            # healthy releases kept per environment
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/campuspulse-deploy
NOTIFY_ENV=$HOME/.config/discord/webhook.env

usage() { sed -n '3,7p' "$0" >&2; exit 64; }
log() { printf '%s %s\n' "$(date -Is)" "$*"; }

notified=0
notify() {  # one line to Discord; the webhook URL goes to curl on stdin, never in argv
  notified=1
  [ -r "$NOTIFY_ENV" ] || return 0
  local url; url=$(sed -n 's/^DISCORD_WEBHOOK_URL=//p' "$NOTIFY_ENV" | tr -d '"\r' | head -1)
  [ -n "$url" ] || return 0
  local data; data=$(python3 -c 'import json,sys; print(json.dumps(json.dumps({"content": sys.argv[1]})))' "$1")
  printf 'url = "%s"\nheader = "Content-Type: application/json"\ndata = %s\n' "$url" "$data" \
    | curl -s -m 10 -K - >/dev/null || true
}

# Any failure that didn't report itself reaches Discord with the line it happened on.
env=?; version=?; phase=start; failed_line=?; work=
trap 'failed_line=$LINENO' ERR
on_exit() {
  local rc=$?
  if [ -n "$work" ] && [[ $work == "$STATE"/work.* ]]; then rm -rf -- "$work"; fi
  if [ $rc -ne 0 ] && [ $rc -ne 64 ] && [ "$notified" = 0 ]; then
    notify "🔴 CampusPulse API $env $version: deploy failed during '$phase' (line $failed_line, exit $rc)"
  fi
}
trap on_exit EXIT

# ---- arguments ------------------------------------------------------------------------------
force=0; args=()
for a in "$@"; do if [ "$a" = --force ]; then force=1; else args+=("$a"); fi; done
set -- "${args[@]}"
[ $# -ge 2 ] || usage
if [ "$1" = rollback ]; then mode=rollback; env=$2; [ $# -eq 2 ] || usage
else mode=deploy; env=$1; [ $# -eq 3 ] || usage; run_id=$2; ref=$3; fi
case $env in
  stage) unit=campuspulse-api-stage; port=5093 ;;
  prod)  unit=campuspulse-api;       port=5092 ;;
  *) usage ;;
esac
user=campuspulse-$env
base=$ROOT/apps/api-$env
envfile=$ROOT/.config/campuspulse/api-$env.env
history=$base/history            # root-owned; one line per healthy switch: "<time> <version> <kind>"

# One deploy per environment at a time, in a lock directory only this user can write.
install -d -m 700 "$STATE"
exec > >(tee -a "$STATE/deploy.log") 2>&1   # webhook and hand runs alike
exec 9>"$STATE/$env.lock"
flock -w 900 9 || { log "another $env deploy has held the lock for 15 min"; exit 1; }

# ---- helpers --------------------------------------------------------------------------------
live_dir() { readlink -e "$base/current" || true; }          # empty when nothing is live

running_from() {                                             # the live process's working dir
  local pid; pid=$(systemctl show -p MainPID --value "$unit")
  if [ "${pid:-0}" -gt 0 ]; then sudo readlink -e "/proc/$pid/cwd" || true; fi
}

ready() {  # readiness (touches the database); releases from before /health/ready only have /health
  local u=http://127.0.0.1:$port
  curl -sf -m 5 --retry 30 --retry-delay 1 --retry-connrefused --retry-all-errors \
    "$u/health/ready" >/dev/null && return 0
  [ "$(curl -s -o /dev/null -w '%{http_code}' -m 5 "$u/health/ready" || true)" = 404 ] \
    && curl -sf -m 5 "$u/health" >/dev/null
}

switch_to() {  # $1 = release dir. Succeeds only if the service now runs FROM it and is ready.
  local target=$1
  sudo ln -sfn "$target" "$base/current.new" \
    && sudo mv -T "$base/current.new" "$base/current" \
    && sudo systemctl enable --quiet "$unit" \
    && sudo systemctl restart "$unit" \
    && ready \
    && [ "$(live_dir)" = "$target" ] \
    && [ "$(running_from)" = "$target" ]
}

record() {  # $1 = version, $2 = kind (deploy|rollback)
  printf '%s %s %s\n' "$(date -Is)" "$1" "$2" | sudo tee -a "$history" >/dev/null
}

older_healthy() {  # the healthy release before the live one (strictly backwards), if it still exists
  # Candidates are deploys, minus versions a rollback abandoned (unless deployed again since).
  local live; live=$(basename "$(live_dir)" 2>/dev/null || true)
  [ -f "$history" ] || return 0
  local -a order=(); local -A abandoned=(); local t v k
  while read -r t v k; do
    case $k in
      deploy) order+=("$v"); unset 'abandoned[$v]' ;;
      abandoned) abandoned[$v]=1 ;;
    esac
  done < "$history"
  local -a cand=(); local i
  for (( i = 0; i < ${#order[@]}; i++ )); do
    v=${order[i]}; [ -n "${abandoned[$v]:-}" ] || cand+=("$v")
  done
  local start=$(( ${#cand[@]} - 1 ))
  for (( i = ${#cand[@]} - 1; i >= 0; i-- )); do                # the live version's newest deploy
    if [ "${cand[i]}" = "$live" ]; then start=$(( i - 1 )); break; fi
  done
  for (( i = start; i >= 0; i-- )); do
    v=${cand[i]}
    if [ "$v" != "$live" ] && [ -d "$base/releases/$v" ]; then echo "$base/releases/$v"; return 0; fi
  done
  return 0
}

prune() {  # keep the live release and the newest $KEEP healthy ones; everything else goes
  local live; live=$(basename "$(live_dir)" 2>/dev/null || true)
  local -A keep=()
  if [ -n "$live" ]; then keep[$live]=1; fi
  local -a deploys=(); local t v k n=0 i d
  if [ -f "$history" ]; then while read -r t v k; do deploys+=("$v"); done < "$history"; fi
  for (( i = ${#deploys[@]} - 1; i >= 0 && n < KEEP; i-- )); do
    if [ -z "${keep[${deploys[i]}]:-}" ]; then keep[${deploys[i]}]=1; n=$(( n + 1 )); fi
  done
  for d in "$base"/releases/*/; do
    d=${d%/}
    [ -d "$d" ] || continue
    [ -n "${keep[$(basename "$d")]:-}" ] && continue
    case $d in "$base"/releases/?*) sudo rm -rf -- "$d"; log "pruned $(basename "$d")" ;; esac
  done
  return 0
}

# ---- rollback -------------------------------------------------------------------------------
if [ "$mode" = rollback ]; then
  phase=rollback
  cur_dir=$(live_dir); cur=$(basename "$cur_dir" 2>/dev/null || echo none)
  prev=$(older_healthy)
  if [ -z "$prev" ]; then log "rollback $env: no older healthy release"; notified=1; exit 1; fi
  version=$(basename "$prev")
  log "rollback $env: $cur -> $version (code only: the schema stays as it is)"
  if switch_to "$prev"; then
    [ -n "$cur_dir" ] && record "$cur" abandoned
    record "$version" rollback
    log "rollback $env: healthy"; notify "↩️ CampusPulse API $env rolled back from $cur to $version"; exit 0
  fi
  log "rollback $env: $version is UNHEALTHY, going back to $cur"
  if [ -n "$cur_dir" ] && switch_to "$cur_dir"; then
    notify "🔴 CampusPulse API $env: rollback to $version failed its checks; still on $cur"
  else
    notify "🔴 CampusPulse API $env: rollback to $version failed and $cur didn't come back either"
  fi
  exit 1
fi

# ---- deploy: check the run with GitHub; never trust the arguments ---------------------------
phase=verify
[[ $run_id =~ ^[0-9]+$ ]] || { log "bad run id: $run_id"; exit 64; }
case $env in
  stage) [[ $ref =~ ^[0-9a-f]{40}$ ]] || { log "stage needs the full 40-char commit sha: $ref"; exit 64; }
         version=${ref:0:7}; want_path=$CI_WORKFLOW; want_event=push; want_branch=main ;;
  prod)  [[ $ref =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { log "bad release tag: $ref"; exit 64; }
         version=$ref; want_path=$RELEASE_WORKFLOW; want_event=release; want_branch=$ref ;;
esac
IFS=$'\t' read -r r_repo r_path r_event r_branch r_status r_concl r_sha < <(
  gh api "repos/$REPO/actions/runs/$run_id" \
    --jq '[.repository.full_name, .path, .event, .head_branch, .status, .conclusion, .head_sha] | @tsv')
problems=()
[ "$r_repo" = "$REPO" ]          || problems+=("repo $r_repo")
[ "$r_path" = "$want_path" ]     || problems+=("workflow $r_path")
[ "$r_event" = "$want_event" ]   || problems+=("event $r_event")
[ "$r_branch" = "$want_branch" ] || problems+=("ref $r_branch")
{ [ "$r_status" = completed ] && [ "$r_concl" = success ]; } || problems+=("run $r_status/$r_concl")
[ "$env" = prod ] || [ "$r_sha" = "$ref" ] || problems+=("sha $r_sha")
if [ ${#problems[@]} -gt 0 ]; then
  log "refusing run $run_id for $env: ${problems[*]}"
  notify "🔴 CampusPulse API $env: refused run $run_id (${problems[*]})"; exit 1
fi

if [ "$env" = stage ]; then
  tip=$(gh api "repos/$REPO/commits/main" --jq .sha)
  if [ "$tip" != "$ref" ] && [ "$force" = 0 ]; then
    log "deploy stage $version: superseded by main at ${tip:0:7}, skipping (use --force to deploy it anyway)"; exit 0
  fi
else
  IFS=$'\t' read -r rel_pre rel_draft < <(gh api "repos/$REPO/releases/tags/$ref" --jq '[.prerelease, .draft] | @tsv')
  if [ "$rel_pre" != false ] || [ "$rel_draft" != false ]; then
    log "refusing $ref: prerelease=$rel_pre draft=$rel_draft"
    notify "🔴 CampusPulse API prod: refused $ref (prerelease or draft)"; exit 1
  fi
  onmain=$(gh api "repos/$REPO/compare/$r_sha...main" --jq .status)
  if [ "$onmain" != ahead ] && [ "$onmain" != identical ]; then
    log "refusing $ref: its commit ${r_sha:0:7} is not on main ($onmain)"
    notify "🔴 CampusPulse API prod: refused $ref, its commit is not on main"; exit 1
  fi
  live_v=$(basename "$(live_dir)" 2>/dev/null || true)
  if [[ $live_v =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$live_v" != "$ref" ] && [ "$force" = 0 ] \
     && [ "$(printf '%s\n%s\n' "$live_v" "$ref" | sort -V | tail -1)" = "$live_v" ]; then
    log "deploy prod $ref: older than the live $live_v, skipping (use --force to deploy it anyway)"; exit 0
  fi
fi

rel=$base/releases/$version
live=$(live_dir)
# A re-delivered webhook or a re-run of the same build: already live and ready is done.
if [ "$rel" = "$live" ] && [ "$(running_from)" = "$live" ] && ready; then
  log "deploy $env $version: already live and healthy, nothing to do"; exit 0
fi

# ---- download -------------------------------------------------------------------------------
phase=download
work=$(mktemp -d "$STATE/work.XXXXXX")
log "deploy $env $version (run $run_id): downloading"
mkdir -p "$work/app" "$work/bundle"
if [ "$env" = stage ]; then
  names=$(gh api "repos/$REPO/actions/runs/$run_id/artifacts" --jq '[.artifacts[].name] | join(" ")')
  gh run download "$run_id" -R "$REPO" -n campuspulse-api -D "$work/app"
  if [[ " $names " == *" campuspulse-efbundle "* ]]; then
    gh run download "$run_id" -R "$REPO" -n campuspulse-efbundle -D "$work/bundle"
  elif [ "$force" = 1 ]; then
    log "run $run_id has no migrations bundle: --force, deploying without migrations"
  else
    log "run $run_id has no campuspulse-efbundle artifact (built before migrations existed?)"
    notify "🔴 CampusPulse API stage $version: run $run_id has no migrations bundle"; exit 1
  fi
else
  gh release download "$ref" -R "$REPO" -p campuspulse-api.tar.gz -p efbundle -D "$work"
  phase=attestation
  for f in campuspulse-api.tar.gz efbundle; do
    if ! gh attestation verify "$work/$f" --repo "$REPO" \
        --cert-identity "https://github.com/$REPO/$RELEASE_WORKFLOW@refs/tags/$ref" \
        --source-ref "refs/tags/$ref" --source-digest "$r_sha" \
        --deny-self-hosted-runners >/dev/null; then
      log "$f of $ref has no valid attestation from $RELEASE_WORKFLOW"
      notify "🔴 CampusPulse API prod $ref: $f failed attestation, not deployed"; exit 1
    fi
  done
  tar -xzf "$work/campuspulse-api.tar.gz" -C "$work/app"
  mv "$work/efbundle" "$work/bundle/efbundle"
fi
if [ ! -f "$work/app/CampusPulse.Api.dll" ]; then
  log "the build has no CampusPulse.Api.dll"
  notify "🔴 CampusPulse API $env $version: the build has no CampusPulse.Api.dll"; exit 1
fi

# ---- install into a staging dir outside releases/, root-owned and read-only to the app -------
phase=install
incoming=$base/.incoming/$version
sudo install -d -m 755 "$base/.incoming"
sudo rm -rf -- "${incoming:?}"
sudo install -d -m 755 "$incoming"
sudo cp -a "$work/app/." "$incoming/"
if [ -f "$work/bundle/efbundle" ]; then sudo install -m 755 "$work/bundle/efbundle" "$incoming/efbundle"; fi
sudo chown -R root:root "$incoming"
sudo chmod -R u=rwX,go=rX "$incoming"

# ---- migrations: a sandboxed one-off unit as the environment's user --------------------------
if [ -x "$incoming/efbundle" ]; then
  phase=migrations
  # (Re)load the network guard right before running build code: never trust that it's still there.
  if ! sudo nft -f /etc/campuspulse/netguard.nft; then
    log "the network guard (/etc/campuspulse/netguard.nft) didn't load: refusing to run build code"
    notify "🔴 CampusPulse API $env $version: network guard didn't load, migrations not run"; exit 1
  fi
  log "deploy $env $version: migrations"
  # systemd reads the env file (root-only); the bundle takes ConnectionStrings__Postgres from its
  # environment, so no connection string is ever passed in argv.
  if ! sudo systemd-run --quiet --wait --pipe --collect \
        --unit="campuspulse-migrate-$env-$$" \
        -p User="$user" -p Group="$user" \
        -p EnvironmentFile="$envfile" -p WorkingDirectory="$incoming" \
        -p CacheDirectory="campuspulse-efbundle-$env" \
        -E DOTNET_BUNDLE_EXTRACT_BASE_DIR="/var/cache/campuspulse-efbundle-$env" \
        -p "TemporaryFileSystem=/srv:ro /mnt:ro /nas:ro" -p BindReadOnlyPaths="$incoming" \
        -p NoNewPrivileges=yes -p PrivateTmp=yes -p PrivateDevices=yes \
        -p ProtectSystem=strict -p ProtectHome=yes -p ProtectKernelTunables=yes \
        -p ProtectKernelModules=yes -p ProtectKernelLogs=yes -p ProtectControlGroups=yes \
        -p ProtectClock=yes -p ProtectHostname=yes -p ProtectProc=invisible \
        -p RestrictSUIDSGID=yes -p RestrictNamespaces=yes -p RestrictRealtime=yes \
        -p LockPersonality=yes -p SystemCallArchitectures=native -p SystemCallFilter=@system-service \
        -p "RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK" \
        -p CapabilityBoundingSet= -p UMask=0077 -p RuntimeMaxSec=300 \
        "$incoming/efbundle"; then
    log "deploy $env $version: MIGRATIONS FAILED; the live code is unchanged, the schema may be partly migrated"
    notify "🔴 CampusPulse API $env $version: migrations failed. $(basename "${live:-none}") is still running; the schema may be partly migrated"
    sudo rm -rf -- "${incoming:?}"
    exit 1
  fi
fi

# ---- switch ---------------------------------------------------------------------------------
phase=switch
old_copy=
if [ -d "$rel" ]; then  # the same version was installed before (and isn't live, or isn't healthy)
  if [ "$rel" = "$live" ]; then log "$version is live but not healthy: reinstalling"; fi
  old_copy=$base/.incoming/$version.old.$$
  sudo mv -T "$rel" "$old_copy"
fi
sudo mv -T "$incoming" "$rel"
log "deploy $env $version: switching and restarting"
if switch_to "$rel"; then
  record "$version" deploy
  log "deploy $env $version: healthy"
  if [ "$env" = prod ]; then notify "🟢 CampusPulse API prod is now $version"; fi
else
  log "deploy $env $version: UNHEALTHY"
  if [ -n "$old_copy" ]; then sudo rm -rf -- "${rel:?}"; sudo mv -T "$old_copy" "$rel"; fi
  if [ -n "$live" ] && [ "$live" != "$rel" ] && [ -d "$live" ]; then fallback=$live; else fallback=$(older_healthy); fi
  if [ -n "$fallback" ] && switch_to "$fallback"; then
    notify "🔴 CampusPulse API $env $version failed its checks; back on $(basename "$fallback")"
  elif [ -z "$live" ]; then
    # first deploy: nothing to go back to; stop it so it doesn't crash-loop or start at boot, and
    # drop `current` so the next deploy doesn't mistake this never-healthy release for the live one
    sudo systemctl disable --now --quiet "$unit" || true
    sudo rm -f -- "$base/current"
    notify "🔴 CampusPulse API $env $version (first deploy) failed its checks; the service is stopped and disabled"
  else
    notify "🔴 CampusPulse API $env $version failed its checks and no healthy release came back; it stays enabled on the last attempt, check it"
  fi
  exit 1
fi

phase=prune
sudo rm -rf -- "$base"/.incoming/* 2>/dev/null || true   # leftovers of earlier failed runs
prune
log "deploy $env $version: done"
