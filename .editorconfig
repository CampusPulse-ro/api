# Editor and `dotnet format` settings. `dotnet format --verify-no-changes` runs in CI, and
# EnforceCodeStyleInBuild (Directory.Build.props) makes the build apply the IDE rules below.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf

# Windows PowerShell 5.1 reads a BOM-less script as ANSI.
[*.ps1]
charset = utf-8-bom

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# Usings: System first, outside the namespace, no blank lines between groups.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Layout used throughout the codebase.
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Naming: PascalCase types, members and constants; IPascalCase interfaces; _camelCase private
# fields. The analyzer orders rules by specificity, so the const rule wins over the field rule.
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal
dotnet_naming_rule.types_and_members_pascal.severity = suggestion
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = suggestion
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

# Written by the build (Microsoft.Extensions.ApiDescription.Server) exactly as committed; CI fails
# when it differs. Never edit it by hand, and don't let an editor add a final newline.
[openapi/*.json]
insert_final_newline = false

# EF Core writes migrations with block namespaces, a UTF-8 BOM and no auto-generated header:
# treat them as generated so style rules (IDE0161 under -warnaserror) and the charset check skip them.
[src/CampusPulse.Infrastructure/Migrations/*.cs]
generated_code = true
